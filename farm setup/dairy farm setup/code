<script data-purpose="application-logic">
    // Offline status toggle interaction
    let isOfflineActive = true;
    function toggleOfflineStatus() {
      isOfflineActive = !isOfflineActive;
      const text = document.getElementById('offlineStatusText');
      const badge = document.getElementById('offlineStatusBadge');
      
      if (isOfflineActive) {
        text.innerText = 'Works offline';
        badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#dcf3eb] text-[#1b6b57] text-[11px] font-medium tracking-tight shadow-sm cursor-pointer select-none press-effect transition-colors duration-200';
        showToast('Cached: Farm plans accessible offline');
      } else {
        text.innerText = 'Live sync on';
        badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-[11px] font-medium tracking-tight shadow-sm cursor-pointer select-none press-effect transition-colors duration-200';
        showToast('Connected to live sync server');
      }
    }

    // Category filter button handling
    function filterCategory(btn, category) {
      document.querySelectorAll('.filter-pill').forEach(pill => {
        pill.className = 'filter-pill press-effect px-5 py-2 rounded-full text-[13.5px] font-medium transition-all bg-white text-stone-700 border border-stone-200/90 hover:border-stone-300';
      });
      btn.className = 'filter-pill press-effect px-5 py-2 rounded-full text-[13.5px] font-medium transition-all bg-[#173629] text-white shadow-sm shadow-stone-900/10';
      
      const journeyIndicator = document.getElementById('activeJourneyCategory');
      if (category === 'dairy') {
        journeyIndicator.textContent = 'Dairy, 10 cows';
      } else if (category === 'poultry') {
        journeyIndicator.textContent = 'Broiler & Layer models';
      } else if (category === 'goat') {
        journeyIndicator.textContent = 'Goat stall-fed, 20+1';
      } else {
        journeyIndicator.textContent = 'All available plans';
      }
      showToast(`Showing ${category.charAt(0).toUpperCase() + category.slice(1)} plans`);
    }

    // Search bar functionality
    function handleSearch(term) {
      const q = term.trim().toLowerCase();
      const clearBtn = document.getElementById('clearSearchBtn');
      const items = document.querySelectorAll('.journey-item');
      const noResults = document.getElementById('noResultsState');
      const searchKeyword = document.getElementById('searchKeyword');

      if (q.length > 0) {
        clearBtn.classList.remove('hidden');
        clearBtn.classList.add('flex');
      } else {
        clearBtn.classList.add('hidden');
        clearBtn.classList.remove('flex');
      }

      let visibleCount = 0;
      items.forEach(item => {
        const text = item.innerText.toLowerCase();
        if (text.includes(q)) {
          item.style.display = 'flex';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (visibleCount === 0 && q.length > 0) {
        searchKeyword.innerText = q;
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }

    function clearSearch() {
      const input = document.getElementById('searchInput');
      input.value = '';
      handleSearch('');
      input.focus();
    }

    // Modal display handlers
    function openGuideModal() {
      const modal = document.getElementById('guideModal');
      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        modal.querySelector('div').classList.remove('translate-y-8');
      }, 10);
    }

    function closeGuideModal() {
      const modal = document.getElementById('guideModal');
      modal.classList.add('opacity-0');
      modal.querySelector('div').classList.add('translate-y-8');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 200);
    }

    function showStepDetails(stepNumber, title) {
      document.getElementById('modalTitle').innerText = `Step ${stepNumber}: ${title}`;
      document.getElementById('modalBody').innerText = `Detailed breakdown, blueprints, equipment vendor contacts and regulatory forms for ${title}. Ready for offline download.`;
      openGuideModal();
    }

    // Toast notification utility
    function showToast(msg) {
      const toast = document.getElementById('toastNotification');
      toast.innerText = msg;
      toast.classList.remove('-translate-y-12', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('-translate-y-12', 'opacity-0');
      }, 2000);
    }

    // Bottom tab active switcher
    function setActiveTab(button) {
      const nav = button.closest('nav');
      nav.querySelectorAll('button').forEach(btn => {
        btn.classList.remove('text-[#15382b]');
        btn.classList.add('text-stone-400');
        const span = btn.querySelector('span');
        if (span) {
          span.classList.remove('font-bold', 'text-stone-900');
          span.classList.add('font-semibold');
        }
        const indicator = btn.querySelector('.bg-\\[\\#15382b\\]');
        if (indicator) indicator.remove();
      });

      button.classList.remove('text-stone-400');
      button.classList.add('text-[#15382b]');
      const label = button.querySelector('span');
      if (label) {
        label.classList.add('font-bold', 'text-stone-900');
        label.classList.remove('font-semibold');
      }
    }
  </script>


