<script data-purpose="app-logic">
    // Step Data definitions
    const stepDatabase = {
      1: {
        tag: "PLAN",
        title: "From egg to bird: how a poultry farm works",
        content: `
          <p>Understanding production lifecycles is key before buying stock:</p>
          <ul class="list-disc pl-4 space-y-1 mt-2">
            <li><strong>Broilers:</strong> Reared specifically for meat. Fast turnaround from day-old chick to harvest in 35-42 days.</li>
            <li><strong>Layers:</strong> Reared for table eggs. Growing cycle takes 18-20 weeks, laying cycle spans up to 72 weeks.</li>
            <li><strong>Hatcheries &amp; Breeders:</strong> High-bio-security parent farms producing fertile eggs for commercial incubation.</li>
          </ul>
        `
      },
      2: {
        tag: "PLAN · SITING",
        title: "Where can you build? The siting rules",
        content: `
          <p>National environmental guidelines dictate strict placement boundaries:</p>
          <ul class="list-disc pl-4 space-y-1 mt-2">
            <li><strong>500 meters:</strong> Minimum distance from residential areas, schools, hospitals, and public parks.</li>
            <li><strong>200 meters:</strong> Minimum distance from major water reservoirs, rivers, and canals.</li>
            <li><strong>100 meters:</strong> Distance from national and state highways to mitigate odour impact.</li>
          </ul>
        `
      },
      3: {
        tag: "REGISTER · LEGAL",
        title: "Which kind of poultry farm are you?",
        content: `
          <p>Your bird count directly decides state pollution approvals:</p>
          <ul class="list-disc pl-4 space-y-1 mt-2">
            <li><strong>Small (5,000–25,000):</strong> Green Category. Self-declaration and basic SPCB consent.</li>
            <li><strong>Medium (25,000–1,00,000):</strong> Green/Orange boundary. Requires engineered waste pits.</li>
            <li><strong>Large (>1,00,000 birds):</strong> Full Orange Category status requiring detailed environment plans and quarterly compliance reports.</li>
          </ul>
        `
      },
      4: {
        tag: "BUILD · INFRASTRUCTURE",
        title: "Build it right: the farm rule book",
        content: `
          <p>Engineering recommendations for farm safety and biosecurity:</p>
          <ul class="list-disc pl-4 space-y-1 mt-2">
            <li>Orient sheds <strong>East-to-West</strong> to reduce direct sunlight and internal heat load.</li>
            <li>Maintain clear distance of 30-40 feet between adjacent sheds for cross ventilation.</li>
            <li>Concrete floors with smooth screed for effective washing between bird batches.</li>
            <li>Dedicated dry covered shed for manure storage during monsoon months.</li>
          </ul>
        `
      },
      5: {
        tag: "MARKET · DISTRIBUTION",
        title: "Poultry across India: where the birds are",
        content: `
          <p>Market dynamics and leading clusters across the states:</p>
          <ul class="list-disc pl-4 space-y-1 mt-2">
            <li><strong>Tamil Nadu &amp; Andhra Pradesh:</strong> Largest egg production hubs (Namakkal cluster).</li>
            <li><strong>Haryana &amp; Punjab:</strong> Primary suppliers for North Indian urban centers.</li>
            <li><strong>Maharashtra &amp; West Bengal:</strong> Rapidly expanding integrated broiler contract operations.</li>
          </ul>
        `
      }
    };

    // Modal Control Functions
    function openModal(id) {
      const el = document.getElementById(id);
      if (el) {
        el.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      if (el) {
        el.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    // Step detail viewer
    function openStepDetails(stepNumber) {
      const step = stepDatabase[stepNumber];
      if (!step) return;
      document.getElementById('stepTag').innerText = step.tag;
      document.getElementById('stepTitle').innerText = step.title;
      document.getElementById('stepContent').innerHTML = step.content;
      openModal('stepModal');
    }

    // Bird Calculator logic
    function calculateFarmCategory() {
      const birds = parseInt(document.getElementById('birdInput').value) || 0;
      const resName = document.getElementById('resCategoryName');
      const resConsent = document.getElementById('resConsent');
      const resDesc = document.getElementById('resDescription');
      const resBuffer = document.getElementById('resBuffer');

      if (birds < 5000) {
        resName.innerText = "Backyard / Unregulated (<5,000 birds)";
        resConsent.innerText = "No SPCB CTO Needed";
        resDesc.innerText = "Exempt from complex state board permissions. Must follow basic local sanitation and hygiene guidelines.";
        resBuffer.innerText = "100 meters";
      } else if (birds <= 25000) {
        resName.innerText = "Small Farm (5,000 - 25,000 birds)";
        resConsent.innerText = "Green Category CTO";
        resDesc.innerText = "Consent to Operate required from SPCB. Simple fee structure with 5-year renewal.";
        resBuffer.innerText = "500 meters";
      } else if (birds <= 100000) {
        resName.innerText = "Medium Farm (25,000 - 1,00,000 birds)";
        resConsent.innerText = "Full CTE & CTO Required";
        resDesc.innerText = "Requires both Consent to Establish and Consent to Operate. Siting verification enforced.";
        resBuffer.innerText = "500 meters";
      } else {
        resName.innerText = "Large Farm (>1,00,000 birds)";
        resConsent.innerText = "Orange Category Clearance";
        resDesc.innerText = "Strict regulatory oversight with environmental impact reporting and compulsory mechanical manure drying.";
        resBuffer.innerText = "1,000 meters";
      }
    }

    // Search filter interaction
    const searchInput = document.getElementById('searchInput');
    searchInput.addEventListener('input', function(e) {
      const query = e.target.value.toLowerCase().trim();
      const items = document.querySelectorAll('.guide-item');
      let visibleCount = 0;

      items.forEach(item => {
        const text = item.innerText.toLowerCase();
        if (text.includes(query)) {
          item.style.display = 'flex';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });
      document.getElementById('guideCount').innerText = visibleCount;
    });

    // Pill Filtering Demo
    const filterPills = document.querySelectorAll('.filter-pill');
    filterPills.forEach(pill => {
      pill.addEventListener('click', function() {
        filterPills.forEach(p => {
          p.classList.remove('bg-forest', 'text-white');
          p.classList.add('bg-white', 'text-[#3E4942]', 'border', 'border-[#D8DCD6]');
        });
        this.classList.remove('bg-white', 'text-[#3E4942]', 'border', 'border-[#D8DCD6]');
        this.classList.add('bg-forest', 'text-white');
        
        const type = this.getAttribute('data-filter');
        showToast(type === 'poultry' ? 'Showing Poultry guides' : `Showing ${this.innerText} guides`);
      });
    });

    // Toast notification helper
    function showToast(message) {
      const toast = document.getElementById('toast');
      const msg = document.getElementById('toastMessage');
      msg.innerText = message;
      toast.classList.remove('opacity-0', 'pointer-events-none');
      toast.classList.add('opacity-100');
      setTimeout(() => {
        toast.classList.remove('opacity-100');
        toast.classList.add('opacity-0', 'pointer-events-none');
      }, 2500);
    }

    // Active bottom navigation styling
    function setActiveNav(button) {
      const navButtons = document.querySelectorAll('nav button');
      navButtons.forEach(btn => {
        btn.classList.remove('text-forest');
        btn.classList.add('text-[#7E8B83]');
      });
      button.classList.add('text-forest');
      button.classList.remove('text-[#7E8B83]');
    }

    // Modal background click to close
    window.addEventListener('click', function(e) {
      ['counterModal', 'guideModal', 'stepModal', 'checklistModal'].forEach(id => {
        const modal = document.getElementById(id);
        if (e.target === modal) {
          closeModal(id);
        }
      });
    });
  </script>
<!-- END: Logic & Interactivity Script -->


